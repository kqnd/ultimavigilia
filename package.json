{
  "name": "ultima-vigilia",
  "productName": "Última Vigília",
  "version": "1.3.0",
  "description": "Jogo cooperativo top-down de sobrevivência por hordas em pixel art (Electron + Phaser + TypeScript).",
  "author": "Álex Almeida",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.cjs",
  "type": "module",
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/opentype.js": "1.3.10",
    "@types/ws": "8.18.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "opentype.js": "2.0.0",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "phaser": "4.2.1",
    "ws": "8.21.3"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:two": "node scripts/dev.mjs --two",
    "start": "npm run build && electron .",
    "start:two": "npm run build && node scripts/two.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build": "node scripts/build-node.mjs && vite build",
    "bench": "node --import tsx tools/bench.ts",
    "sprites": "node --import tsx tools/export-sprites.ts",
    "font": "node --import tsx tools/build-font.ts",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --dir",
    "server": "npm run build && node dist/server/server.cjs --host 0.0.0.0 --port 7777",
    "simulate": "node --import tsx tools/simulate.ts",
    "icon": "node --import tsx tools/build-icon.ts",
    "e2e": "node tools/e2e.mjs",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
